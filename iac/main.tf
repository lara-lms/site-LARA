provider "kubernetes" {
  host                   = "http://localhost:8080/api/v1/kubernetes/proxy"
  client_certificate     = base64decode("")
  client_key             = base64decode("")
  cluster_ca_certificate = base64decode("")
}

resource "kubernetes_service" "lara_site_service" {
  metadata {
    name = var.app_namme
  }

  spec {
    type = "LoadBalancer"
    selector = {
      app = var.app_namme
    }
    port {
      port = 8081
      target_port = var.app_container_port
    }
  }
}

resource "kubernetes_deployment" "lara_site_deployment" {
  metadata {
    name = var.app_namme
    labels = {
      app = var.app_namme
    }
  }

  spec {
    replicas = 2

    selector {
      match_labels = {
        app = var.app_namme
      }
    }

    template {
      metadata {
        labels = {
          app = var.app_namme
        }
      }

      spec {
        container {
          name = var.app_namme
          image = "alaninformatica/lara-site:${var.image_tag}"

          port {
            container_port = var.app_container_port
          }
        }
      }
    }
  }
}